# Copy to server/.env. Never commit real secrets.

NODE_ENV=development
PORT=4000
# Browser origins allowed to call the API and Socket.IO, comma-separated.
# Include every front end (marketplace, admin panel) and local dev ports. Subdomain wildcards work: https://*.suregad.in
CORS_ORIGINS=https://suregad.in,https://www.suregad.in,https://dashboard.suregad.in,http://localhost:5173,http://localhost:5174
# Legacy fallback used only when CORS_ORIGINS is empty.
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# MongoDB Atlas connection string, for example mongodb+srv://user:pass@cluster.mongodb.net/suregad
MONGODB_URI=

# Cloudinary is the asset store. Product and evidence uploads fail closed in production when these are empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web push. Generate a pair with the web-push library. The public key is also copied to client/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@suregad.com

REDIS_URL=
ADMIN_BOOTSTRAP_EMAILS=
DATA_ENCRYPTION_KEY=

# Dev-only login. Ignored when NODE_ENV=production.
ALLOW_DEV_AUTH=false
DEV_AUTH_SECRET=

# Paste the Firebase Admin service account. Private key newlines must stay as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MONTHLY_TOKEN_BUDGET=200000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SureGad <noreply@suregad.com>"
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=SUREGD
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
