{
  "name": "@suregad/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-system-ca.mjs tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/server.cjs --sourcemap",
    "start": "node scripts/start.mjs",
    "seed": "node scripts/with-system-ca.mjs tsx src/seed/cli.ts",
    "seed:demo": "node scripts/with-system-ca.mjs tsx src/seed/cli.ts --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit --pretty false",
    "seed:demo-gallery": "node scripts/with-system-ca.mjs tsx src/seed/cli.ts --demo-gallery",
    "seed:demo-applicants": "node scripts/with-system-ca.mjs tsx src/seed/cli.ts --demo-applicants",
    "seed:firebase-demo": "node scripts/with-system-ca.mjs tsx src/seed/cli.ts --firebase-demo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "bullmq": "^5.63.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "mongoose": "^8.20.1",
    "pino": "^9.14.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.1",
    "web-push": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.12"
  }
}
